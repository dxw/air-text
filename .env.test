# Dotenv
#
# This file commits safe environment variables for the test environment.
# For managing sensitive values and overrides use `/.env.test.local`
#
# Reference=https://github.com/bkeepers/dotenv#what-other-env-files-can-i-use

CERC_FORECAST_API_HOST_URL=https://cerc.example.com
CERC_FORECAST_API_KEY=SECRET-API-KEY
CERC_FORECAST_API_CACHE_LIMIT_MINS=60

CERC_SUBSCRIBER_API_HOST_URL=https://cerc.example.com
CERC_SUBSCRIBER_API_KEY=SECRET-API-KEY

MAPTILER_API_KEY=TOPSECRET

# Secret key used in hashing of emails and phone numbers for verification tokens
SECRET_KEY=SECRET-KEY