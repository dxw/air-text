<%= render 'form_step' do |f| %>
  <div class="text-block">
    <h3>Would you like to help us improve the airTEXT service?</h3>
  </div>

  <div class="mb-4">
    <%= f.label :reason, "Why are you signing up for airTEXT alerts?" %>
    <%= f.collection_select :reason, SubscriptionCreationForm::REASONS, :first, :second, prompt: "Select..." %>
  </div>

  <div class="mb-4">
    <%= f.label :source, "How did you hear about the airTEXT service?" %>
    <%= f.collection_select :source, SubscriptionCreationForm::SOURCES, :first, :second, prompt: "Select..." %>
  </div>

  <div class="mb-4">
    <%= f.label :research, "Are you happy to be contacted about your experience of airTEXT?" %>
    <%= f.collection_radio_buttons :research, [["Yes", true], ["No", false]], :last, :first do |b| %>
      <div class="radio-wrapper mb-2">
        <%= b.radio_button %>
        <%= b.label %>
      </div>
    <% end %>
  </div>

  <div class="mb-2 checkbox-wrapper">
    <%= f.check_box :terms, required: true %>
    <%= f.label :terms, "I have read and I agree to the #{link_to "terms and conditions", terms_and_conditions_path, class: "a", data: { "turbo-frame": :_top }}".html_safe %>
  </div>

  <div class="mb-6 checkbox-wrapper">
    <%= f.check_box :privacy, required: true %>
    <%= f.label :privacy, "I have read and I agree to the #{link_to "privacy policy", privacy_policy_path, class: "a", data: { "turbo-frame": :_top }}".html_safe %>
  </div>
<% end %>
