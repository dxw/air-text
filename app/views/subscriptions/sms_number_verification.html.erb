<%= render 'form_step' do |f| %>
  <h3 class="h3 mb-2">Verify your mobile number for SMS messages</h3>
  <p class="mb-2">A code has been sent to <b><%= @form.sms_number %></b>.</p>
  <%= f.label :verification_code_sms_number, "Verification code", class: "sr-only" %>
  <%= f.text_field :verification_code_sms_number, placeholder: 'Enter the code', value: nil, class: "mb-2" %>
  <p>If the code does not arrive, please check your spam folder. You can also
  <%= button_tag "resend the code", data: { "subscription-target": "resendVerificationButton", action: "subscription#resendVerification", mode: "sms" }, type: :button, class: "a" %>.
  </p>
<% end %>
