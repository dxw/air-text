
  <%= render 'form_step' do |f| %>
  <div class="text-block" id="confirmation-page">
    <h2 class="mb-4">Subscription Confirmation</h2>
    <p>You will receive alerts for the following channels and areas:</p>

    <section class="mb-4">
      <header>
        <h3>Channels</h3>
        <p><%= link_to "Edit", wizard_path(:contact_details) %></p>
      </header>
      <dl>
        <dt>Email</dt>
        <dd><%= @form.email.presence || "Not selected" %></dd>
        <dt>Text</dt>
        <dd><%= @form.sms_number.presence || "Not selected" %></dd>
        <dt>Voicemail</dt>
        <dd><%= @form.voice_number.presence || "Not selected" %></dd>
      </dl>
    </section>

    <section class="mb-4">
      <header>
        <h3>Alert areas</h3>
        <p><%= link_to "Edit", wizard_path(:zone_selection) %></p>
      </header>
      <ul class="list">
        <% @form.zones.each do |zone| %>
          <li><%= zone %></li>
        <% end %>
      </ul>
    </section>

    <section class="mb-4">
      <header>
        <h3>Selected time</h3>
        <p><%= link_to "Edit", wizard_path(:time_selection) %></p>
      </header>
      <ul class="list">
        <li><%= SubscriptionForm::TIMES[@form.time][:label] %></li>
      </ul>
    </section>
  </div>
<% end %>
