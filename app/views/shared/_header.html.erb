<header class="site-header" data-controller="navigation" role="banner">
  <div class="header-content">
    <div class="header-top">
      <%= link_to render_svg("logo", tag: :div, classes: "site-logo"), root_path, title: "airTEXT homepage" %>
      <button data-action="navigation#toggleMenu" data-navigation-target="menuButton">Menu</button>
    </div>
    <hr>
    <nav aria-label="Main navigation">
      <ul data-navigation-target="menuList">
        <%= render "shared/nav" %>
      </ul>
    </nav>
  </div>
</header>
