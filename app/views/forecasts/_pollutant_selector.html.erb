<h3 class="h3 mt-2">Filter map by pollutants</h3>
<%= form_tag(false, class: "pollutant-selector", data: { "map-target": "pollutantSelector", "forecast-target": "pollutantSelector" } ) do %>
  <%= collection_radio_buttons nil, :pollutant, {
    "All pollutants" => 'Total',
    "Nitrogen Dioxide" => 'NO2',
    "Particles < 2.5µm" => 'PM25',
    "Particles < 10µm" => 'PM10',
    "Ozone" => 'O3',
  }, :second, :first, checked: @pollutant do |b| %>
    <div class="pollutant">
      <%= b.radio_button data: { action: "forecast#changePollutant" }, form: "forecast-form" %>
      <%= b.label tabindex: 0, data: { action: "keydown->forecast#selectPollutant" }  %>
    </div>
  <% end %>
<% end %>
<p class="mt-1 explanatory-link pollutant-info-link"><%= link_to("Learn more about the different pollutants", health_advice_path, class: "a") %></p>
