<%= form_tag(false, method: :get) do %>
  <%= select_tag :zone, 
  options_for_select(Zone.all.order(:name).map(&:name), @zone.name),
  data: { "prediction-target": "zoneSelector", action: "change->prediction#changeZone" }
  %>
  <%= hidden_field_tag :day, @day, data: { "prediction-target": "daySelector" } %>
<% end %>
