<% content_for :title, 'Air pollution forecast' %>
<% content_for :head do %>
   <meta name="turbo-cache-control" content="no-cache">
<% end %>

<div id="intro" class="text-block px-3">
  <h1 class="mt-3 mb-2">Air pollution forecast</h1>
  <p>The air you breathe matters.</p>
  <p>To reduce your exposure to air pollution use the forecast, map, and health guidance to help you plan your routes and outdoor activities.</p>
  <p>The forecast covers air pollution, pollen, temperature and UV rays.</p>
  <p>You can also get alerted when air pollution is expected to be higher than usual.</p>
  <%= link_to("Sign up to get free alerts", subscriptions_path, class: "primary-cta my-4") %>
</div>

<div id="forecast" data-controller="map forecast" class="px-3 mb-2">
  <%= render "forecast_form" %>
  <%= render "forecast_tabs" %>

  <div class="tab-contents" role="tabpanel">
    <%= render "alert_guidance" %>
    <%= render "map" %>

    <%= render "predictions" %>
    <%= render "sharing" %>
  </div>
</div>

<%= render "shared/health_advice" %>
<%= render "how_forecasts_are_made" %>

<div id="daqi-scale-info" class="mobile-flyout">
  <%= button_tag("Close", class: "close", data: { action: "click->map#closeDaqiScaleFlyout", controller: "map" }) %>
  <%= render "daqi_scale_guide" %>
</div>

<div class="p-3">
  <%= render "shared/back_to_top" %>
</div>
