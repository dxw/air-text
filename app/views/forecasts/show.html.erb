<% content_for :title, 'Air quality forecast' %>
<% content_for :head do %>
   <meta name="turbo-cache-control" content="no-cache">
<% end %>

<h1 class="h1 px-2 mt-3 mb-2">Air quality forecast</h1>
<div id="intro" class="text-block px-2">
  <p>The air quality forecast displays levels of air pollution, ultraviolet (UV) rays, pollen, and temperature over the next three days for London, Surrey, Chelmsford, Maldon, Colchester and Cambridge.</p>
  <%= link_to("Sign up for air quality alerts", subscriptions_path, class: "primary-cta my-4") %>
</div>

<div id="forecast" data-controller="map forecast" class="px-2 mb-2">
  <%= render "forecast_form" %>
  <%= render "forecast_tabs" %>

  <div class="tab-contents" role="tabpanel">
    <%= render "alert_guidance" %>
    <%= render "map" %>

    <%= render "predictions" %>
    <%= render "sharing" %>
  </div>
</div>

<%= render "shared/health_advice" %>
<%= render "how_forecasts_are_made" %>

<div id="daqi-scale-info" class="mobile-flyout">
  <%= button_tag("Close", class: "close", data: { action: "click->map#closeDaqiScaleFlyout", controller: "map" }) %>
  <%= render "daqi_scale_guide" %>
</div>

<div class="mb-2 mx-2">
  <%= render "shared/back_to_top" %>
</div>
