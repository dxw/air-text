<% content_for :title, 'Air pollution alerts' %>

<article>
  <div class="text-block p-3">
    <h1>Air pollution alerts</h1>
    <p>An alert is raised when air pollution is expected to be higher than usual (moderate, high or very high on the Daily Air Quality Index).</p>
    <p>No alert is raised for low air pollution, so you won’t get an alert on these days.</p>
    <p>The forecasts go up to 3 days ahead, so you can plan ahead in terms of clothing, medication, routes and outdoor activities.</p>
    <p>Follow the <%= link_to "health guidance", health_advice_path %> to reduce the effects of air pollution, pollen, extreme weather, and UV.</p>

    <div class="mt-3 mobile-only">
      <p>Sign up to get free alerts sent to your mobile phone, email or voicemail.</p>
      <%= link_to("Sign up to free alerts", subscriptions_path, class: "primary-cta") %>
    </div>
  </div>

  <div class="details-wrapper pb-2">
    <%  ZoneGroup.all.order(:order).each do |group| %>
    <details class="zone-region-group px-3">
      <summary class="p-2">
        <h2><%= group.name %></h4>
        <%= content_tag :p, group.description, class: "mt-1" if group.description.present? %>
      </summary>
      <div class="air-quality-alerts-table">
        <% if @alerts[group.name]&.any? %>
        <div class="table-header">
            <h3 class="cell">Today</h3>
            <h3 class="cell"><%= (Date.today + 1.day).strftime("%A") %></h3>
            <h3 class="cell"><%= (Date.today + 2.days).strftime("%A") %></h3>
        </div>
        <% end %>

        <div class="table-body">
          <% @alerts[group.name]&.each do |alert| %>
            <div class="row">
              <div class="zone-name cell">
                <h4><%= alert.data.first.zone[:name] %></h4>
                <%= link_to "Forecast", forecast_path(zone: alert.data.first.zone[:name], zoom: 10), class: "a" %>
              </div>
              <% alert.data.each do |forecast| %>
                <div class="zone-day-alert cell">
                  <% if forecast.air_pollution[:label] == "LOW" %>
                    <span class="label">No alert</span>
                  <% else %>
                    <span class="label <%= "daqi-level-#{forecast.air_pollution[:total]}"%>"><%= forecast.air_pollution[:label].humanize %></span>
                    <span class="value">Index <%= forecast.air_pollution[:total] %>/10</span>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>

          <% unless @alerts[group.name].present? %>
            <div class="no-alerts cell">
              <span>No alerts forecast for this area within the next 3 days.</span>
            </div>
          <% end %>
        </div>

        <div class="table-footer my-1">
          <span class="forecast-timestamp cell">Forecast updated at <%= CercForecastService.latest_forecast_date.strftime("%H:%M on %A %d %B %Y") %></span>
        </div>
      </div>
    </details>
    <% end %>
  </div>

  <div class="mobile-only my-4 px-3">
    <%= link_to("Get health guidance", health_advice_path, class: "secondary-cta") %>
  </div>
</article>

<%= render "shared/sidebar" %>
