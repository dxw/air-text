<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <%= render "layouts/open_graph" %>
    <%= favicon_link_tag asset_path('favicons/favicon-96x96.png'), rel: 'icon', type: 'image/png', sizes: '96x96' %>
    <%= favicon_link_tag asset_path('favicons/favicon.svg'), rel: 'icon', type: 'image/svg+xml' %>
    <%= favicon_link_tag asset_path('favicons/favicon.ico'), rel: 'shortcut icon' %>
    <%= favicon_link_tag asset_path('favicons/apple-touch-icon.png'), rel: 'apple-touch-icon', sizes: '180x180' %>
    <%= favicon_link_tag asset_path('site.webmanifest'), rel: 'manifest' %>
    <%= csrf_meta_tags %>
    <%= stylesheet_link_tag "application", media: 'all', "data-turbolinks-track" => "reload" %>
    <%= yield(:head) %>
  </head>
  <body data-controller="application" class="c-<%= controller_name %> a-<%= action_name %>">
    <%= render "shared/header" %>
    <main role="main">
      <%= render "shared/alert_banner" %>
      <%= render "layouts/messages" %>
      <%= yield %>
    </main>
    <%= render "shared/footer" %>
  </body>
  <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
</html>
