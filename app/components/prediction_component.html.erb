<div class="prediction <%= css_name %>">
  <dl class="summary">
    <dt class="name"><%= name %></dt>
    <dd class="display-value"><%= display_value&.html_safe %></dd>
  </dl>
  <% if guidance_visible? %>
  <div class="guidance">
    <%= render(HealthGuidanceComponent.new(css_name.to_sym, level_label.parameterize(separator: "_").to_sym, classes: ["mb-2"])) %>
  </div>
  <% end %>
</div>
