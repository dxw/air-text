<%= tag.div class: "tab #{@day} #{@active ? 'active' : 'inactive'} #{@forecast.air_pollution[:label] == 'LOW' ? 'bg-white' : daqi_indicator_colour_class}",
  data: {
    date: @forecast.date.to_s,
    day: @day,
    action: "click->forecast#changeDay",
  } do
  %>
  <div class="day">
    <%= @forecast.date == Date.today ? 'Today' : @forecast.date.strftime('%A') %>
  </div>
  <div class="date">
    <%= @forecast.date.strftime("%d %B") %>
  </div>
  <div class="daqi-indicator <%= daqi_indicator_colour_class %> <%= icon_stroke_colour_class %>">
    <% if @forecast.air_pollution[:label] != 'LOW' %>
      <%= helpers.render_svg "exclamation_triangle" %>
    <% end %>
  </div>
  <div class="daqi-label">
    <%= @forecast.air_pollution[:label].capitalize %>
  </div>
  <div class="daqi-value">
    Index <%= @forecast.air_pollution[:total] %>/10
  </div>
<% end %>
